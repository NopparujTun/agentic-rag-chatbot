rent?.click();\n  };\n\n  const handleFileChange = (event: React.ChangeEvent<HTMLInputElement>) => {\n    if (event.target.files && event.target.files.length > 0) {\n      onUploadDocuments(event.target.files);\n    }\n    event.target.value = \"\";\n  };\n\n  return (\n    <>\n      <input\n        ref={fileInputRef}\n        className=\"hidden\"\n        type=\"file\"\n        accept=\"application/pdf,.pdf\"\n        multiple\n        onChange={handleFileChange}\n      />\n      <InputBar\n        status={isSending ? \"streaming\" : \"ready\"}\n        onSend={handleSend}\n        onStop={() => {}}\n        onAttach={handleAttach}\n        disabled={isSending}\n        placeholder=\"Ask anything to start a new chat...\"\n        className=\"w-full max-w-2xl mx-auto\"\n      />\n    </>\n  );\n}\n"]},"_coverageSchema":"1a1c01bbd47fc00a2c39e90264f33305004495a9","hash":"3ad53e0c8c064df55a2de0f9a616fd78aa750de2"}}